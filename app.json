{
  "expo": {
    "name": "قرآني",
    "slug": "quran-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "quranmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#103E35",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#103E35",
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "ios": {
            "imageWidth": 240
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar"
          ],
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
