<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer times widget, always right to left: the next prayer large in gold with its time, the time left in a pill, the place and the date, a hairline, and the day's six times (the next one in a lit box). Filled by PrayerWidget; until then (and without times) it says to open the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/athan_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:layoutDirection="rtl"
  android:background="@drawable/athan_widget_background"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingTop="12dp"
  android:paddingBottom="10dp">
  <TextView
    android:id="@+id/athan_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:lineSpacingExtra="4dp"
    android:text="@string/athan_widget_empty"
    android:textColor="@color/athan_widget_text"
    android:textSize="14sp" />
  <LinearLayout
    android:id="@+id/athan_widget_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="4dp"
      android:paddingEnd="2dp">
      <TextView
        android:id="@+id/athan_widget_next_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/athan_widget_accent"
        android:textSize="26sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/athan_widget_next_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textColor="@color/athan_widget_text"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:textSize="26sp" />
      <Chronometer
        android:id="@+id/athan_widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/athan_widget_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textDirection="rtl"
        android:textColor="@color/athan_widget_accent"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:textSize="13sp" />
    </LinearLayout>
    <TextView
      android:id="@+id/athan_widget_date"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:singleLine="true"
      android:ellipsize="end"
      android:textAlignment="viewStart"
      android:textColor="@color/athan_widget_muted"
      android:textSize="11sp" />
    <!-- A hairline between the next prayer and the day's times. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="5dp"
      android:background="@color/athan_widget_rule" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <LinearLayout
        android:id="@+id/athan_widget_fajr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_fajr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_fajr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_sunrise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_sunrise_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_sunrise_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_dhuhr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_dhuhr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_dhuhr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_asr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_asr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_asr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_maghrib"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_maghrib_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_maghrib_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_isha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_isha_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/athan_widget_isha_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
