<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer times notification, expanded: the next prayer and the time left, the date, then the day's six times. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:layoutDirection="rtl"
  android:paddingBottom="2dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="true">
    <TextView
      android:id="@+id/athan_times_next_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:singleLine="true"
      android:textColor="@color/athan_times_accent"
      android:textSize="20sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/athan_times_next_time"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:singleLine="true"
      android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
      android:fontFamily="sans-serif-medium"
      android:fontFeatureSettings="tnum"
      android:textSize="20sp" />
    <Chronometer
      android:id="@+id/athan_times_countdown"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:singleLine="true"
      android:textDirection="rtl"
      android:textColor="@color/athan_times_accent"
      android:fontFamily="sans-serif-medium"
      android:fontFeatureSettings="tnum"
      android:textSize="15sp" />
  </LinearLayout>
  <TextView
    android:id="@+id/athan_times_date"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:singleLine="true"
    android:ellipsize="end"
    android:textAppearance="@android:style/TextAppearance.Material.Notification"
    android:textSize="13sp" />
  <!-- A hairline between the next prayer and the list. -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    android:background="@color/athan_times_rule" />
