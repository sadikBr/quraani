<?xml version="1.0" encoding="utf-8"?>
<!-- The prayer times widget where it has room (a tall cell, as on Xiaomi's launcher), always right to left: the next prayer large and centred with its time, the time left in a pill and the place and date under it, filling the height; then a hairline and the day's six times at the foot. Filled by PrayerWidget, which chooses this layout by the widget's height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/athan_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:gravity="center"
  android:layoutDirection="rtl"
  android:background="@drawable/athan_widget_background"
  android:padding="16dp">
  <TextView
    android:id="@+id/athan_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:lineSpacingExtra="4dp"
    android:text="@string/athan_widget_empty"
    android:textColor="@color/athan_widget_text"
    android:textSize="14sp" />
  <LinearLayout
    android:id="@+id/athan_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical"
      android:gravity="center">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/athan_widget_next"
        android:textColor="@color/athan_widget_muted"
        android:textSize="13sp" />
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">
        <TextView
          android:id="@+id/athan_widget_next_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_accent"
          android:textSize="38sp"
          android:textStyle="bold" />
        <TextView
          android:id="@+id/athan_widget_next_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="14dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-light"
          android:fontFeatureSettings="tnum"
          android:textSize="38sp" />
      </LinearLayout>
      <Chronometer
        android:id="@+id/athan_widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/athan_widget_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textDirection="rtl"
        android:textColor="@color/athan_widget_accent"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:textSize="15sp" />
      <TextView
        android:id="@+id/athan_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/athan_widget_muted"
        android:textSize="12sp" />
    </LinearLayout>
    <!-- A hairline between the next prayer and the day's times. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="6dp"
      android:layout_marginBottom="8dp"
      android:background="@color/athan_widget_rule" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
      <LinearLayout
        android:id="@+id/athan_widget_fajr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_fajr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_fajr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_sunrise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_sunrise_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_sunrise_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_dhuhr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_dhuhr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_dhuhr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_asr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_asr_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_asr_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_maghrib"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_maghrib_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_maghrib_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/athan_widget_isha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
          android:id="@+id/athan_widget_isha_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/athan_widget_isha_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:singleLine="true"
          android:textColor="@color/athan_widget_text"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:textSize="15sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
