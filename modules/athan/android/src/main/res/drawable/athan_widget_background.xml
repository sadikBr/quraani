<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's ground: the app's green, deepening toward the foot, inside a thin gold line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient android:angle="270" android:startColor="@color/athan_widget_ground_top" android:endColor="@color/athan_widget_ground" />
  <stroke android:width="1dp" android:color="@color/athan_widget_edge" />
  <corners android:radius="24dp" />
</shape>
